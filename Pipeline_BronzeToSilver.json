                                },
                                "enableStaging": false,
                                "translator": {
                                    "type": "TabularTranslator",
                                    "typeConversion": true,
                                    "typeConversionSettings": {
                                        "allowDataTruncation": true,
                                        "treatBooleanAsNumber": false
                                    }
                                }
                            },
                            "inputs": [
                                {
                                    "referenceName": "bronze_new",
                                    "type": "DatasetReference"
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "bronzearchive",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "foldername": {
                                            "value": "@concat(\n    'bronze/archive/',\n    split(item().name, '_')[0]\n)",
                                            "type": "Expression"
                                        },
                                        "filename": {
                                            "value": "@concat(\n    split(split(item().name, '_')[1], '.')[0],\n    '__',\n    formatDateTime(utcNow(), 'yyyy-MM-ddTHH''h''mm''m''ss''s'''),\n    '.csv'\n)",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
